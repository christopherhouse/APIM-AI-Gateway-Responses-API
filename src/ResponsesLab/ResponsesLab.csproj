<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ResponsesLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="[3.0.0-beta.3]" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="[1.25.0]" />
    <PackageReference Include="OpenAI" Version="[2.14.0]" />
  </ItemGroup>

</Project>
