<policies>
  <inbound>
    <base />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-backend-service backend-id="probe-pool" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    <trace source="affinity-probe" severity="information">
      <message>@("inbound:" + context.RequestId.ToString())</message>
    </trace>
  </inbound>
  <backend>
    <forward-request timeout="60" />
  </backend>
  <outbound>
    <set-variable name="probeMember" value="@{
      var host = context.Request.Url.Host;
      if (host == &quot;__HOST_A__&quot;) { return &quot;backend-a&quot;; }
      if (host == &quot;__HOST_B__&quot;) { return &quot;backend-b&quot;; }
      return &quot;unresolved&quot;;
    }" />
    <set-header name="X-Lab-Backend-Id" exists-action="override">
      <value>@((string)context.Variables["probeMember"])</value>
    </set-header>
    <set-header name="X-Probe-Request-Host" exists-action="override">
      <value>@(context.Request.Url.Host)</value>
    </set-header>
    <set-header name="X-Probe-Backend-Context" exists-action="override">
      <value>@(context.Backend == null ? "" : context.Backend.Id)</value>
    </set-header>
    <set-header name="X-Probe-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <trace source="affinity-probe" severity="information">
      <message>@("outbound:" + context.RequestId.ToString() + ":" + (string)context.Variables["probeMember"] + ":" + context.Request.Url.Host)</message>
    </trace>
    <base />
  </outbound>
  <on-error>
    <set-header name="X-Probe-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
    <trace source="affinity-probe" severity="error">
      <message>@("on-error:" + context.RequestId.ToString() + ":" + context.LastError.Reason)</message>
    </trace>
    <base />
  </on-error>
</policies>
